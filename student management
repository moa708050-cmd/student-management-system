#include <iostream>
#include <string>
using namespace std;

const int MAX = 100;

struct Student
{
    int id;
    string name;
    int age;
    string department;
    float grade;
};

Student students[MAX];
int countStudents = 0;

void addStudent();
void displayStudents();
void searchStudent();
void updateStudent();
void deleteStudent();
void showTopStudent();
void showAverage();

int main()
{
    int choice;

    do
    {
        cout << "\n=====================================\n";
        cout << "   STUDENT MANAGEMENT SYSTEM\n";
        cout << "=====================================\n";
        cout << "1. Add Student\n";
        cout << "2. Display Students\n";
        cout << "3. Search Student\n";
        cout << "4. Update Student\n";
